PORT=4000
HOST=127.0.0.1
DB_PATH=./data/rca.sqlite
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
# Workflow API URL/token are configured on the local runner, never on this VPS.
# Remote Terminal runs only on the Windows Local Agent, never in this backend.
SEED_EMAIL=owner@example.com
SEED_PASSWORD=replace-with-a-long-password
SEED_NAME=Owner

# WFI-06: SQLite jobs metadata/receipt migration is automatic in the core backend.
# Protocol-2 Local Runner keeps workflow-journal.sqlite beside CREDENTIALS_PATH.
# Engine 0.5.0 uses journal schema 2 and jobsVersion=1; upgrade components together.
# Keep runtime directories private (Windows NTFS ACL / POSIX permissions).
# Jobs never survive an expired lease as executable queue; unknown is not replayed.
# Metadata/key retention defaults are 30/90 days; unresolved/unacked is not purged.
# See docs/WORKFLOW_JOBS.md. No new env setting is needed to enable replay.
# WFI-07 receipt lookup uses existing cookie auth/membership; no new env required.
# WFI-08: back up SQLite consistently before rollout; image rollback does not restore DB.
# See docs/WORKFLOW_OPERATIONS.md. No new runtime env settings are required.
