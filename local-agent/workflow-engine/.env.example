# Local-only engine configuration. Never copy this machine's .env to the VPS.
LOCAL_AGENT_PORT=34719
LOCAL_AGENT_MODE=integrated
# Relative to this engine package; missing/invalid policy denies remote grants.
LOCAL_AGENT_POLICY_FILE=./data/workflow-policy.json
CHROME_PROFILE=Default
# Required in integrated mode. Set a random 32-256 printable ASCII token locally.
LOCAL_AGENT_API_TOKEN=
# Optional local content metadata sync; no MongoDB connection without a URI.
MONGODB_URI=
MONGODB_DATABASE=team_content
# LOCAL_AGENT_DATA_DIR=D:/WorkflowData
# LOCAL_AGENT_SCENARIOS_DIR=D:/WorkflowScenarios
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# CHROME_USER_DATA_DIR=D:/WorkflowChrome/User Data
# YTDLP_PATH=C:/VideoTools/yt-dlp.exe
# FFMPEG_PATH=C:/VideoTools/ffmpeg.exe
# FFPROBE_PATH=C:/VideoTools/ffprobe.exe
# No legacy control-server polling in this distribution.

# Core supervisor managed mode supplies LOCAL_AGENT_ENV_DISABLED=1 internally.
# Store this file privately: NTFS ACL current user/SYSTEM/Administrators, or mode 600.
# Configure WORKFLOW_SUPERVISOR_MODE in local-agent/.env, not here.

# WFI-05: match engine LOCAL_AGENT_PORT, runner WORKFLOW_AGENT_URL and
# extension Options port (default 34719, supported 1024-65535).
# Chrome paths are local-only absolute paths; allowOpen is controlled by local policy.
# GUI startup requires the correct logged-in user, never Windows Session 0.
# See docs/WORKFLOW_CHROME.md in the core repository.
