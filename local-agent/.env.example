SERVER_URL=http://localhost:4000
PAIR_CODE=
CREDENTIALS_PATH=./data/credentials.json
# Seconds between CPU/RAM/network reports (5-60; default 10).
STATUS_INTERVAL_SECONDS=10
# Remote Terminal session maximum (60-3600 seconds; default 1800).
TERMINAL_MAX_SECONDS=1800
# Close an idle terminal after 60-1800 seconds (default 600).
TERMINAL_IDLE_SECONDS=600
# Pairing requires explicit approval in this machine console.
AUTO_APPROVE_SESSIONS=false
ALLOW_INSECURE_REMOTE=false

# Workflow engine on the same machine; use the path to its existing .env.
# Protocol 2 revokes its grant on lease expiry/revoke/disconnect.
WORKFLOW_AGENT_ENABLED=true
# 2 requires an integrated engine with a locally approved policy. Use 1 only for legacy standalone engines.
WORKFLOW_AGENT_PROTOCOL=2
WORKFLOW_AGENT_URL=http://127.0.0.1:34719
# Relative to local-agent/. Keep an existing external engine env path when attaching it.
WORKFLOW_AGENT_ENV_FILE=./workflow-engine/.env

# Safe default for an existing installation. Managed requires the packaged lifecycleVersion=1 engine,
# a private engine env file, and the existing engine stopped locally first.
# No frontend setting can change this mode. See docs/WORKFLOW_SUPERVISOR.md.
WORKFLOW_SUPERVISOR_MODE=attach

# WFI-05: match engine LOCAL_AGENT_PORT, runner WORKFLOW_AGENT_URL and
# extension Options port (default 34719, supported 1024-65535).
# Chrome paths are local-only absolute paths; allowOpen is controlled by local policy.
# GUI startup requires the correct logged-in user, never Windows Session 0.
# See docs/WORKFLOW_CHROME.md in the core repository.

# WFI-06: SQLite jobs metadata/receipt migration is automatic in the core backend.
# Protocol-2 Local Runner keeps workflow-journal.sqlite beside CREDENTIALS_PATH.
# Engine 0.5.0 uses journal schema 2 and jobsVersion=1; upgrade components together.
# Keep runtime directories private (Windows NTFS ACL / POSIX permissions).
# Jobs never survive an expired lease as executable queue; unknown is not replayed.
# Metadata/key retention defaults are 30/90 days; unresolved/unacked is not purged.
# See docs/WORKFLOW_JOBS.md. No new env setting is needed to enable replay.
# WFI-08: docs/WORKFLOW_OPERATIONS.md covers ACL, interactive startup and backups.
# Test auto-approval/Chrome flags belong to isolated fixtures, not production setup.
