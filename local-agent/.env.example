SERVER_URL=http://localhost:4000
PAIR_CODE=
CREDENTIALS_PATH=./data/credentials.json
# Seconds between CPU/RAM/network reports (5-60; default 10).
STATUS_INTERVAL_SECONDS=10
SCRIPTS_PATH=./data/scripts.json
# Remote Terminal session maximum (60-3600 seconds; default 1800).
TERMINAL_MAX_SECONDS=1800
# Close an idle terminal after 60-1800 seconds (default 600).
TERMINAL_IDLE_SECONDS=600
# Pairing requires explicit approval in this machine console.
AUTO_APPROVE_SESSIONS=false
ALLOW_INSECURE_REMOTE=false
