{
  "scripts": [
    {
      "id": "workflow.run",
      "label": "Chạy workflow",
      "description": "Chạy workflow được cài sẵn trên máy này.",
      "executable": "node",
      "cwd": "../my-workflow",
      "args": ["local-agent.js", "run"],
      "timeoutSeconds": 3600,
      "parameters": [
        {
          "name": "scenario",
          "label": "Scenario",
          "type": "text",
          "required": true,
          "maxLength": 64,
          "flag": "--scenario"
        },
        {
          "name": "profile",
          "label": "Profile",
          "type": "choice",
          "required": true,
          "flag": "--profile",
          "options": [
            {"value": "Profile 1", "label": "Profile 1"},
            {"value": "Profile 2", "label": "Profile 2"}
          ]
        },
        {
          "name": "variablesFile",
          "label": "Variables file",
          "type": "file",
          "required": true,
          "flag": "--variables-file",
          "options": [
            {"value": "default", "label": "run-values.json", "path": "run-values.json"}
          ]
        },
        {
          "name": "wait",
          "label": "Wait until finished",
          "type": "boolean",
          "required": false,
          "flag": "--wait"
        }
      ]
    }
  ]
}
